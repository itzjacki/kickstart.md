{
  "name": "kickstart.md",
  "version": "2.0.2",
  "description": "CLI tool that helps kickstart AI development in your project",
  "keywords": [
    "AI",
    "LLM",
    "kiro",
    "kiro-cli",
    "kickstart"
  ],
  "homepage": "https://github.com/itzjacki/kickstart.md#readme",
  "bugs": {
    "url": "https://github.com/itzjacki/kickstart.md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzjacki/kickstart.md.git"
  },
  "license": "MIT",
  "author": "Team Summit",
  "type": "module",
  "bin": {
    "kickstart.md": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "release": "release-it"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "skills": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "release-it": "21.1.0",
    "typescript": "^6.0.3"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
    "git": {
      "commit": true,
      "tag": true,
      "push": true
    },
    "github": {
      "release": true,
      "autoGenerate": true
    },
    "npm": {
      "publish": true
    },
    "hooks": {
      "before:init": "npm run typecheck",
      "after:bump": "npm run build"
    }
  }
}
